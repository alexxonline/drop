# --- server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Which peers are allowed to set X-Forwarded-For, as a comma-separated list of
# addresses, CIDR ranges, or the presets loopback/linklocal/uniquelocal. The
# default trusts a reverse proxy on the same host plus the private ranges Docker
# publishes ports from. Never set this to `true`: any client could then claim
# any IP, forging the address the rate limiter and the logs work from.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Where the app UI lives. In dev this is the Vite dev server.
APP_ORIGIN=http://localhost:5173

# Separate hostname that serves user-uploaded bytes (/f and /s).
# Leave empty in dev to collapse onto APP_ORIGIN; the server warns at boot.
# In production this MUST differ from APP_ORIGIN — see SPEC.md §7.
CONTENT_ORIGIN=

# openssl rand -hex 32
SESSION_SECRET=

# --- google oauth -----------------------------------------------------------
# Cloud console → APIs & Services → Credentials → OAuth client ID → Web app.
# Authorised redirect URI: ${APP_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Only these addresses can sign in.
ALLOWED_EMAILS=you@gmail.com

# --- cloudflare r2 ----------------------------------------------------------
# R2 → Manage API tokens → Object Read & Write, scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=drop

# --- storage & limits -------------------------------------------------------
DATABASE_PATH=./data/drop.db
MAX_UPLOAD_BYTES=104857600

# Upload bytes held in memory at once, across all requests. Every upload is
# buffered whole, so this is what bounds the process against a burst of large
# ones. Defaults to three times MAX_UPLOAD_BYTES; must be at least one.
UPLOAD_MEMORY_BUDGET_BYTES=314572800

# Requests per minute per IP. Uploads (60) and the content routes (1200) set
# their own; the health check is exempt.
RATE_LIMIT_PER_MINUTE=600
DEFAULT_TTL_SECONDS=86400
MAX_TTL_SECONDS=2592000
SWEEP_INTERVAL_MS=60000
MAX_ZIP_ENTRIES=2000
MAX_ZIP_TOTAL_BYTES=314572800
